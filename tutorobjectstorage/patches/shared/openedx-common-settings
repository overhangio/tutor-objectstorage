_s3_backend_class = "storages.backends.s3boto3.S3Boto3Storage"

# Teak (Tutor 20.x) vs Verawood/Ulmo: Teak's edx-platform never defines
# STORAGES (it's still on the old DEFAULT_FILE_STORAGE string setting) even
# though it runs Django 4.2.20 - a django.VERSION check would get this
# backwards, so this is presence-detection, same idiom edx-platform's own
# resolve_storage_backend()/get_profile_image_storage() use for this exact
# boundary. Setting both STORAGES and DEFAULT_FILE_STORAGE in one settings
# module raises ImproperlyConfigured, confirmed live - keep this a clean if/else.
if "STORAGES" in globals():
    STORAGES["default"]["BACKEND"] = _s3_backend_class
else:
    DEFAULT_FILE_STORAGE = _s3_backend_class

VIDEO_IMAGE_SETTINGS["STORAGE_KWARGS"]["location"] = VIDEO_IMAGE_SETTINGS["STORAGE_KWARGS"]["location"].lstrip("/")
VIDEO_TRANSCRIPTS_SETTINGS["STORAGE_KWARGS"]["location"] = VIDEO_TRANSCRIPTS_SETTINGS["STORAGE_KWARGS"]["location"].lstrip("/")
GRADES_DOWNLOAD["STORAGE_KWARGS"] = {"location": GRADES_DOWNLOAD["STORAGE_KWARGS"]["location"].lstrip("/")}
GRADES_DOWNLOAD["STORAGE_KWARGS"]["bucket_name"] = "{{ OBJSTORAGE_GRADES_BUCKET_NAME }}"

# OPENEDX_LEARNING doesn't exist in Teak's edx-platform source at all - it
# only works there because Tutor core's own bundled template defensively
# pre-defines a fallback. That's an implementation detail of Tutor core, not
# a guarantee from edx-platform, so this stays guarded rather than assumed.
if "OPENEDX_LEARNING" in globals():
    OPENEDX_LEARNING["MEDIA"]["BACKEND"] = _s3_backend_class
    OPENEDX_LEARNING["MEDIA"]["OPTIONS"] = {
        'bucket_name': "{{ OBJSTORAGE_OPENEDX_LEARNING_BUCKET_NAME }}",
    }

# Ora2 setting
ORA2_FILEUPLOAD_BACKEND = "s3"
FILE_UPLOAD_STORAGE_BUCKET_NAME = "{{ OBJSTORAGE_FILE_UPLOAD_BUCKET_NAME }}"

AWS_DEFAULT_ACL = None
AWS_QUERYSTRING_EXPIRE = 7 * 24 * 60 * 60  # 1 week: this is necessary to generate valid download urls

# Also set by tutor-contrib-s3; ported here for all three backends. Harmless
# where unused, and reinforces that none of this plugin's init tasks
# auto-create buckets via django-storages' own bucket-creation path either.
AWS_AUTO_CREATE_BUCKET = False

from botocore.client import Config as BotoConfig # Importing explicitly just to be safe

# boto3 >= 1.36 sends a CRC32 checksum on every upload by default, which
# non-AWS S3 implementations reject. Restricting checksums to operations
# that require them keeps uploads working against every backend here. Also
# set as a standalone Django setting (as tutor-contrib-s3 does) in addition
# to the BotoConfig fields each backend sets below, in case a given
# django-storages version reads one but not the other.
AWS_REQUEST_CHECKSUM_CALCULATION = "when_required"
